{
  "name": "phazeo-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "astro check",
    "quality": "pnpm check && pnpm typecheck",
    "validate": "pnpm quality && pnpm build",
    "clean": "rm -rf dist node_modules .astro",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@fontsource/outfit": "5.3.0",
    "astro": "7.4.4",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "motion": "12.29.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,mjs}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  }
}
