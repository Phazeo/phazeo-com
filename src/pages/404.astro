---
import BaseLayout from "../components/layout/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title={`Page not found | ${site.name}`}>
  <main class="flex min-h-screen items-center justify-center px-6">
    <div class="mx-auto max-w-xl text-center">
      <h1 class="text-3xl font-semibold tracking-tight text-neutral-900 md:text-4xl">
        Page not found
      </h1>
      <p class="mt-6 text-lg text-neutral-600">
        The page you are looking for does not exist or has moved.
      </p>
      <div class="mt-10">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
        >
          Back to home
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
