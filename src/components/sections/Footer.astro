---
import { site } from "../../data/site";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 bg-white py-10">
  <div class="mx-auto max-w-7xl px-6 md:px-8 lg:px-12">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <div class="flex items-center gap-3">
        <img
          src={site.logo}
          alt="Phazeo"
          class="h-8 w-8"
          width="32"
          height="32"
        />
        <span class="text-sm text-neutral-500">
          {site.name} &copy; {currentYear}
        </span>
      </div>
      <nav
        class="flex flex-wrap items-center gap-6 md:gap-8"
        aria-label="Footer"
      >
        <a
          href="#projects"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-900"
        >
          Projects
        </a>
        <a
          href="#about"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-900"
        >
          About
        </a>
        <a
          href="#domains"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-900"
        >
          Domains
        </a>
        <span class="hidden text-neutral-300 md:inline" aria-hidden="true"
          >|</span
        >
        <a
          href={site.links.portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-900"
        >
          Portfolio
        </a>
        <a
          href={site.links.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-neutral-600 transition-colors hover:text-neutral-900"
        >
          GitHub
        </a>
      </nav>
    </div>
    <p class="mt-6 text-center text-xs text-neutral-500 md:text-left">
      Building the next phase, thoughtfully.
    </p>
    <p class="mt-2 text-center text-xs text-neutral-500 md:text-left">Vercroft</p>
  </div>
</footer>
