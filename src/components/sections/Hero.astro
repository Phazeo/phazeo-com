---
import { site } from "../../data/site";
import Spotlight from "../ui/Spotlight";
---

<section
  class="relative flex min-h-screen w-full items-center overflow-hidden bg-white antialiased bg-grid-neutral-200"
>
  <Spotlight
    client:visible
    className="-top-40 left-0 md:left-60 md:-top-20"
    fill="#a855f7"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-white [mask-image:radial-gradient(ellipse_at_center,transparent_30%,white)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-7xl px-6 py-20 md:px-8 lg:px-12"
  >
    <div class="grid gap-12 lg:grid-cols-[1fr,auto] lg:items-center lg:gap-16">
      <div class="max-w-2xl">
        <div
          class="mb-6 flex animate-fade-in items-center gap-4"
          style="animation-delay: 0.1s;"
          role="img"
          aria-label="Phazeo"
        >
          <img
            src={site.logo}
            alt=""
            class="h-28 w-28 shrink-0 drop-shadow-2xl md:h-32 md:w-32"
            width="128"
            height="128"
            aria-hidden="true"
          />
          <span
            class="font-wordmark text-3xl font-light tracking-wordmark text-neutral-700 md:text-4xl lg:text-5xl"
          >
            PHAZEO
          </span>
        </div>
        <h1
          class="animate-fade-in bg-gradient-to-b from-neutral-900 to-neutral-600 bg-clip-text text-4xl font-bold tracking-tight text-transparent md:text-5xl lg:text-6xl leading-[1.45]"
          style="animation-delay: 0.2s;"
        >
          Forging the next phase.
        </h1>
        <p
          class="animate-fade-in mt-6 text-lg text-neutral-600 md:text-xl"
          style="animation-delay: 0.3s;"
        >
          A personal product studio building focused tools, experiments, and
          thoughtfully crafted ideas.
        </p>
        <div
          class="animate-fade-in mt-10 flex flex-wrap items-center gap-4"
          style="animation-delay: 0.4s;"
        >
          <a
            href={site.links.portfolio}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-lg bg-neutral-900 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-neutral-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-900"
          >
            View Portfolio
            <svg
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-lg border border-neutral-300 px-5 py-2.5 text-sm font-medium text-neutral-700 transition-colors hover:border-neutral-400 hover:text-neutral-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-500"
          >
            Explore Projects
          </a>
        </div>
        <nav
          class="animate-fade-in mt-8 flex flex-wrap items-center gap-4 text-sm text-neutral-500"
          style="animation-delay: 0.5s;"
          aria-label="Page navigation"
        >
          <a
            href="#projects"
            class="transition-colors hover:text-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-500"
          >
            Scroll to explore
            <span class="ml-1 text-neutral-400" aria-hidden="true">↓</span>
          </a>
        </nav>
      </div>
      <div class="hidden lg:block lg:w-64" aria-hidden="true">
        <!-- Reserved for optional asymmetric visual; keeps balance -->
      </div>
    </div>
  </div>
</section>

<style>
  .bg-grid-neutral-200 {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32' width='32' height='32' fill='none' stroke='rgb(229 231 235 / 0.6)'%3e%3cpath d='M0 .5H31.5V32'/%3e%3c/svg%3e");
  }
</style>
