---
import { site } from "../../data/site";
---

<section id="about" class="relative bg-black py-24 md:py-32">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <!-- Section header -->
    <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
      About
    </h2>

    <!-- Philosophy -->
    <div class="mt-8 space-y-4">
      <p class="text-lg text-neutral-400 leading-relaxed">
        {site.name} is a personal product studio focused on building thoughtful, 
        well-crafted digital experiences. We believe in quality over quantity, 
        shipping when ready, and letting the work speak for itself.
      </p>
      <p class="text-neutral-500">
        Based on the philosophy that the best products come from patience, 
        attention to detail, and genuine care for the end user.
      </p>
    </div>
  </div>
</section>
