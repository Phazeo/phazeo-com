{
  // Static site only: no Worker script ("main"), so no request is billed.
  // No account_id here: CI passes it from the production environment.
  "name": "phazeo-com",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
